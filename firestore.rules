rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(ownerId) {
      return isSignedIn() && request.auth.uid == ownerId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    // 1. Trades collection rules
    match /trades/{tradeId} {
      function isValidTrade(data) {
        return data.tokenAddress is string && data.tokenAddress.size() <= 64 &&
               data.symbol is string && data.symbol.size() <= 16 &&
               data.status in ['PENDING', 'SUCCESS', 'FAILED', 'SIMULATED'] &&
               data.ownerId == request.auth.uid &&
               data.timestamp is string; // Simplified for demo, but usually server timestamp
      }

      allow create: if isSignedIn() && isValidTrade(incoming());
      
      // Secure list query
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      
      allow get: if isOwner(resource.data.ownerId);

      // Bot doesn't need update/delete for now, but if it did:
      // allow update: if isOwner(resource.data.ownerId) && isValidTrade(incoming());
    }

    // 2. Settings collection rules
    match /settings/{userId} {
      function isValidSettings(data) {
        return data.jitoEnabled is bool &&
               data.rustSidecarEnabled is bool &&
               data.simulationMode is bool &&
               data.maxRisk is number && data.maxRisk >= 0 && data.maxRisk <= 100;
      }

      allow read, write: if isOwner(userId);
    }
  }
}
